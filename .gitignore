.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
runs/
data/*.db
# astock.db is NOT deterministically rebuildable (real-market snapshot): it is
# a committed artifact. learning_platform.db stays ignored because build_db.py
# regenerates it from a fixed seed.
!data/astock.db
*.egg-info/
secrets/

# BIRD's question text, evidence and gold SQL are someone else's dataset. The task file is
# regenerated by `scripts/bird_tasks.py` from the download, and `results/bird-agent*.jsonl`
# cites question ids instead of republishing them.
data/tasks_bird*.jsonl
