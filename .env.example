# Copy to .env  -  .env is git-ignored, never commit a real key.
# Any OpenAI-compatible /chat/completions endpoint works.

SQLAGENT_PROVIDER=openai
SQLAGENT_MODEL=deepseek-chat
SQLAGENT_BASE_URL=https://api.deepseek.com/v1
SQLAGENT_API_KEY=sk-your-key-here

# GLM:            base https://open.bigmodel.cn/api/paas/v4        model glm-4-flash
# Qwen/DashScope: base https://dashscope.aliyuncs.com/compatible-mode/v1  model qwen-plus
# OpenAI:         base https://api.openai.com/v1                   model gpt-4o-mini
